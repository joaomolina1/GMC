# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://wnhojvxnamxmpmdislcl.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Alternativa (nova API Supabase): cole aqui o valor sb_secret_...
# SUPABASE_SECRET_KEY=

# AI
ANTHROPIC_API_KEY=

# Phase 2 — Embeddings (Voyage AI, 1536-dim vectors)
# Without this key, falls back to pseudo-embeddings (dev only)
VOYAGE_API_KEY=

# Phase 6 — Enterprise (Entra ID SSO)
# Enable Microsoft login button on /login
NEXT_PUBLIC_ENTRA_ENABLED=false
# Azure AD tenant ID (optional — restricts to your org)
AZURE_AD_TENANT_ID=
# Comma-separated allowed email domains for SSO
ENTRA_ALLOWED_DOMAINS=mediacapital.pt,grupomediacapital.pt
# Restrict email/password signup to ENTRA_ALLOWED_DOMAINS (auto-on when Entra enabled)
NEXT_PUBLIC_SIGNUP_DOMAIN_RESTRICT=false

# TVI BOX — produção de episódios com Veo 3.1 (Gemini API): áudio nativo + lip sync em PT-PT
# Só é necessária para `npm run tvibox:produce`; a app funciona sem ela.
GEMINI_API_KEY=

# Cron — Bearer exigido por /api/cron/* (purge-conversations, sync-models, chartbeat-diretos).
# CRON_SECRET: a Vercel envia-o nos crons diários que ainda cabem no plano Hobby.
# CRON_SCHEDULER_SECRET: o pg_cron do Supabase envia-o no minuto do Chartbeat,
# porque a Hobby recusa horários mais frequentes do que uma vez por dia no vercel.json.
# Sem um destes o handler responde 401. Um secret novo só entra num deploy feito depois de o criares.
CRON_SECRET=
CRON_SCHEDULER_SECRET=

# Chartbeat Real-Time API (zona /chartbeat) — header X-CB-AK. Também tem de existir na Vercel
# (Production + Preview) para o cron ao minuto e para o live da UI.
CHARTBEAT_API_KEY=
