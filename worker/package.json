{
  "name": "@gmc/clips-worker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Worker em container para o módulo de clips: ffmpeg, WhisperX/pyannote e fila de jobs/renders do Supabase",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
