    "test:watch": "vitest"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.107.0",
    "@supabase/supabase-js": "2.49.8",
    "tsx": "^4.19.4",
    "zod": "3.25.42"
  },
  "devDependencies": {
    "@types/node": "^20",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
}
