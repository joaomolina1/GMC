# Supabase (service role — o worker contorna RLS; o trigger de aprovação aplica-se mesmo assim)
SUPABASE_URL=https://wnhojvxnamxmpmdislcl.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Claude (sugestão + validação visual). Custo debitado ao dono do job em usage_logs.
ANTHROPIC_API_KEY=
CLIPS_SUGGEST_MODEL=claude-sonnet-4-5
CLIPS_VISION_MODEL=claude-haiku-4-5

# ASR — WhisperX + pyannote (GPU obrigatória; os modelos pyannote são gated: aceitar termos + HF_TOKEN)
HF_TOKEN=
WHISPER_MODEL=large-v3
WHISPERX_DEVICE=cuda
WHISPERX_COMPUTE_TYPE=float16
WHISPERX_BATCH_SIZE=16
# "fixture" gera transcrição sintética (sem GPU) — SÓ para smoke tests do pipeline
CLIPS_TRANSCRIPTION_PROVIDER=whisperx

# Fila
WORKER_ID=
CLIPS_WORKER_ENABLED=true
CLIPS_POLL_INTERVAL_MS=5000
CLIPS_LEASE_SECONDS=900
CLIPS_HEARTBEAT_MS=60000
CLIPS_PROCESS_JOBS=true
CLIPS_PROCESS_RENDERS=true

# Local
CLIPS_WORK_DIR=/work
CLIPS_RENDER_PRESET=veryfast
CLIPS_RENDER_CRF=20
LOG_LEVEL=info
